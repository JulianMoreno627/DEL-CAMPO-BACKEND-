# ---- Dependencies
node_modules/

# ---- Secrets and credentials (never upload)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
secrets/
credentials*.json
service-account*.json

# ---- Data generated by the app
# Data saved by the server (accounts, password hashes, session secret, orders).
# Anchored with "/" so src/data/ (demo seed) is not ignored.
/data/
*.db
*.sqlite
*.sqlite3
# Photos uploaded during development
public/uploads/
# Generated by "npm run build" (SSG)
public/temporada/

# ---- Logs and temporary files
*.log
npm-debug.log*
logs/
tmp/
*.tmp
coverage/

# ---- OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
