{
  "name": "del-campo-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Backend del Caso de Estudio 3: Plataforma de comercialización directa campesino-consumidor (monorepo de microservicios gRPC)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "infrastructure"
  ],
  "scripts": {
    "build": "node infrastructure/scripts/build-ssg.js",
    "start": "node infrastructure/src/server.js",
    "dev": "node --watch-path=infrastructure/src --watch-path=services --watch-path=packages/shared/src --watch-path=proto infrastructure/src/server.js",
    "test": "node --test \"test/**/*.test.js\" \"packages/*/test/**/*.test.js\" \"services/*/test/**/*.test.js\" \"infrastructure/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  }
}
