{
  "name": "del-campo-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Backend del Caso de Estudio 3: Plataforma de comercialización directa campesino-consumidor (monorepo de microservicios gRPC)",
  "type": "module",
  "main": "src/server.js",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "node scripts/build-ssg.js",
    "prestart": "npm run build",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\" \"packages/*/test/**/*.test.js\" \"services/*/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
