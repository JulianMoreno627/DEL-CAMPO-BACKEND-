# Variables de entorno del backend Del Campo.
# Copie este archivo como .env (desarrollo; `npm run dev` lo lee) y complete los valores.
# NUNCA suba .env a git: está en .gitignore. En Render se configuran en Environment.

# ---- Público (solo el gateway escucha aquí; Render define PORT solo)
PORT=3000

# ---- Base de datos: Neon, cadena CON pooling (host con "-pooler") y sslmode=require.
# Formato: postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Vacía = repositorios en memoria (desarrollo y pruebas).
DATABASE_URL=
# Conexiones por microservicio (6 servicios × 3 = 18 como máximo; PgBouncer de Neon las multiplexa)
DB_POOL_MAX=3
# Solo si su proveedor usa un certificado autofirmado (Neon NO lo necesita)
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Sesiones: secreto compartido por user-service (firma) y el gateway (verifica).
# Genérelo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=

# ---- Frontend y CORS
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos, separados por coma (en producción: la URL de Vercel)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Fotos de los anuncios (catalog-service las escribe, el gateway las sirve en /uploads)
# Por defecto: data/uploads. En Render Free el disco es efímero: se pierden en cada deploy.
# UPLOADS_DIR=

# ---- Puertos gRPC internos (127.0.0.1, nunca públicos)
USER_GRPC_PORT=50051
CATALOG_GRPC_PORT=50052
CART_GRPC_PORT=50053
ORDER_GRPC_PORT=50054
REPUTATION_GRPC_PORT=50055
PRICING_GRPC_PORT=50056
# Tiempo máximo de cada llamada gRPC (ms)
GRPC_DEADLINE_MS=5000

# ---- Memoria: flags de Node de cada microservicio (512 MB en Render Free)
# Agregue --lite-mode para ahorrar ~5 MB más por servicio a costa de un JIT más lento.
SERVICE_NODE_FLAGS=--max-old-space-size=64 --max-semi-space-size=1

# ---- Caché ISR de /productores/:id (segundos)
ISR_REVALIDATE_SECONDS=60

# ---- API de precios de mercado (REST, tercero). Vacía = precios guardados en market_price.
# No hay una URL REST pública de SIPSA verificada (ver docs/MICROSERVICIOS.md).
MARKET_PRICES_API_URL=
MARKET_PRICES_API_TOKEN=
MARKET_PRICES_API_TIMEOUT_MS=4000
MARKET_PRICES_CACHE_TTL_MS=21600000
